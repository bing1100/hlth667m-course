% hlth667m.sty -- minimal Beamer look for HLTH 667M decks.
% Palette matches the notebooks (Okabe-Ito, colour-blind safe).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hlth667m}[2026/09/20 HLTH 667M slide style]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[sfdefault,scaled=.96]{FiraSans}
\RequirePackage[scaled=.86]{FiraMono}
\RequirePackage{newtxsf}
\RequirePackage{microtype}
\RequirePackage{booktabs,array,xpatch}
\RequirePackage{fontawesome5}
\RequirePackage{graphicx,tikz,pgfplots}
\graphicspath{{figures/}}
\RequirePackage[most]{tcolorbox}
\usetikzlibrary{shapes.geometric,arrows.meta,positioning,calc,fit,backgrounds,matrix,decorations.pathreplacing}

% ---------------------------------------------------------------- colours
\definecolor{navy}{HTML}{17324D}
\definecolor{ink}{HTML}{22303C}
\definecolor{muted}{HTML}{6B7A88}
\definecolor{hair}{HTML}{D9E0E6}
\definecolor{paper}{HTML}{FFFFFF}
\definecolor{accent}{HTML}{0072B2}   % blue
\definecolor{warm}{HTML}{D55E00}     % vermilion
\definecolor{good}{HTML}{009E73}     % green
\definecolor{gold}{HTML}{E69F00}     % orange-yellow
\definecolor{sky}{HTML}{56B4E9}
\definecolor{rose}{HTML}{CC79A7}

% ------------------------------------------------------------ beamer base
\usefonttheme{professionalfonts}
\setbeamertemplate{navigation symbols}{}
\setbeamersize{text margin left=11mm,text margin right=11mm}
\setbeamercolor{normal text}{fg=ink,bg=paper}
\setbeamercolor{frametitle}{fg=navy}
\setbeamercolor{structure}{fg=accent}
\setbeamercolor{itemize item}{fg=accent}
\setbeamercolor{itemize subitem}{fg=muted}
\setbeamerfont{frametitle}{size=\Large,series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}

% Frame title: bold navy text over a short accent rule.
\setbeamertemplate{frametitle}{%
  \vspace*{4.2mm}%
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
  \vspace{1.6mm}%
  {\color{accent}\rule{11mm}{1.4pt}}\par
  \vspace{-2.5mm}%
}

% Footer: deck name left, frame number right.
\newcommand{\deckfooter}{HLTH 667M \,\textperiodcentered\, Lab 2}
\setbeamertemplate{footline}{%
  \leavevmode\hbox to \paperwidth{%
    \hspace{11mm}{\usebeamerfont{footline}\color{muted}\deckfooter}\hfill
    {\usebeamerfont{footline}\color{muted}\insertframenumber}\hspace{11mm}}%
  \vspace{4mm}%
}

% Lists: small square bullets and a little air between items.
\setbeamertemplate{itemize item}{\raisebox{.25ex}{\tiny$\blacksquare$}}
\setbeamertemplate{itemize subitem}{\raisebox{.2ex}{\tiny$\blacksquare$}}
\xpatchcmd{\itemize}{\def\makelabel}{\setlength{\itemsep}{5pt}\def\makelabel}{}{}
\setlength{\leftmargini}{1.2em}

% ------------------------------------------------------------- components
% Highlighted one-line conclusion, pinned under the content.
\newtcolorbox{takeawaybox}{enhanced,boxrule=0pt,frame hidden,sharp corners,
  colback=accent!7,borderline west={2.2pt}{0pt}{accent},
  left=4mm,right=3mm,top=1.5mm,bottom=1.5mm,before skip=2mm,after skip=0mm,fontupper=\small\color{ink}}
\newcommand{\takeaway}[1]{\begin{takeawaybox}#1\end{takeawaybox}}

% Worked example panel: the principle lives outside it, the dataset inside it.
\newtcolorbox{examplebox}[1]{enhanced,boxrule=.5pt,colframe=hair,colback=navy!3,arc=2pt,
  left=3mm,right=3mm,top=2mm,bottom=2.5mm,fontupper=\small,
  before upper={{\scriptsize\bfseries\color{muted}\MakeUppercase{Example}\,\textperiodcentered\,#1}\par\vspace{2mm}}}

% Big statistic with a caption: \keynumber[colour]{value}{caption}
\newcommand{\keynumber}[3][navy]{%
  \begin{minipage}[t]{\linewidth}\centering
    {\fontsize{25}{27}\selectfont\bfseries\color{#1}#2}\\[1.2mm]
    {\footnotesize\color{muted}#3}
  \end{minipage}}

% Inline code and token chips.
\newcommand{\code}[1]{{\ttfamily\color{navy}#1}}
\providecommand{\toksize}{\footnotesize}
\newcommand{\tok}[2][accent]{\tikz[baseline=(t.base)]\node[inner xsep=2.2pt,inner ysep=2pt,
  rounded corners=1.4pt,fill=#1!14,draw=#1!55,line width=.4pt,font=\ttfamily\toksize,text=ink](t){#2\vphantom{bg}};}
\newcommand{\eyebrow}[1]{{\footnotesize\bfseries\color{muted}\MakeUppercase{#1}}}
\newcommand{\soft}[1]{{\color{muted}#1}}

% Divider for each tutorial and for each notebook.
\newcommand{\tutorialslide}[3]{{%
  \setbeamercolor{background canvas}{bg=navy}%
  \frame[plain,noframenumbering]{%
    \vfill
    {\footnotesize\bfseries\color{sky}\MakeUppercase{#1}}\\[4mm]
    {\fontsize{30}{34}\selectfont\bfseries\color{white}#2\par}\vspace{5mm}
    {\large\color{white!75!navy}#3\par}
    \vfill\vfill}}}
\newcommand{\notebookslide}[3]{{%
  \setbeamercolor{background canvas}{bg=navy!4}%
  \frame[plain,noframenumbering]{%
    \vfill
    {\footnotesize\bfseries\color{accent}\MakeUppercase{#1}}\\[3mm]
    {\fontsize{24}{28}\selectfont\bfseries\color{navy}#2\par}\vspace{1mm}
    {\color{accent}\rule{11mm}{1.4pt}}\par\vspace{5mm}
    {\large\color{ink}#3\par}
    \vfill\vfill}}}

% Notebook hand-offs. \nbtag marks a slide whose content reproduces a notebook
% output; \nbexample is a whole slide built around an exported notebook figure:
%   \nbexample[height]{Part 2 \S5}{title}{figure name}{takeaway}
\newcommand{\nbtag}[1]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south east,inner xsep=2.2mm,inner ysep=1mm,rounded corners=1.5pt,fill=gold!18,draw=gold!70,
      line width=.4pt,font=\tiny\bfseries,text=ink] at ([xshift=-19mm,yshift=2.6mm]current page.south east)
      {\faIcon{book-open}\hspace{1.6mm}FROM THE NOTEBOOK \,\textperiodcentered\, #1};
  \end{tikzpicture}}
\newcommand{\nbexample}[5][.6\textheight]{%
  \begin{frame}{#3}
    \nbtag{#2}\centering
    \vspace{1mm}
    \includegraphics[width=\linewidth,height=#1,keepaspectratio]{#4}\par
    \vspace{.5mm}
    \takeaway{#5}
  \end{frame}}

% ------------------------------------------------------------------- TikZ
\tikzset{
  stage/.style={rounded corners=2pt,draw=#1,fill=#1!11,line width=.7pt,
    minimum height=9.5mm,inner xsep=3mm,align=center,font=\small,text=ink},
  stage/.default=accent,
  flow/.style={-{Stealth[length=2mm,width=1.6mm]},line width=.7pt,color=muted},
  note/.style={font=\footnotesize,text=muted,align=center},
  kn/.style={stage=#1,font=\footnotesize,minimum height=8mm},kn/.default=accent,
  el/.style={font=\scriptsize,text=muted,fill=white,inner sep=1pt},
  cell/.style={minimum size=8mm,draw=white,line width=1pt,font=\small,text=ink},
}
\pgfplotsset{compat=1.16,
  clean/.style={axis line style={draw=hair},tick style={draw=none},
    ymajorgrids,grid style={draw=hair,line width=.4pt},
    axis x line*=bottom,axis y line*=left,
    tick label style={font=\footnotesize,text=ink},
    label style={font=\footnotesize,text=muted},
    legend style={draw=none,fill=none,font=\footnotesize,legend cell align=left},
    nodes near coords style={font=\footnotesize,text=ink}},
  cleanx/.style={clean,ymajorgrids=false,xmajorgrids,axis y line*=left}}
\endinput
